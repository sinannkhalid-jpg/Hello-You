# ---- App ----
APP_NAME=Hello You
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Security ----
# 32+ char random string for JWT signing (local stub auth)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Database ----
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./osint_nexus.db
# Production (Supabase Postgres):
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:6543/DBNAME
DIRECT_URL=postgresql+psycopg2://USER:PASS@HOST:5432/DBNAME

# ---- Supabase (optional, set USE_SUPABASE=true to enable) ----
USE_SUPABASE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- OSINT provider API keys ----
# Every key is OPTIONAL. Providers without a key are auto-disabled.
# The convention is `<NAME>_API_KEY`; the orchestrator picks it up automatically.

# Have I Been Pwned  — paid key required
HIBP_API_KEY=

# VirusTotal          — free tier: 4 req/min, 500/day
VIRUSTOTAL_API_KEY=

# Shodan              — free tier supported
SHODAN_API_KEY=

# AbuseIPDB           — free tier: 1k req/day
ABUSEIPDB_API_KEY=

# SecurityTrails      — paid key required
SECURITYTRAILS_API_KEY=

# IPAPI (ipapi.co)    — optional paid key for higher rate limits
IPAPI_KEY=

# Gravatar            — no key needed (public API)

# LeakCheck           — public endpoint works without a key; key raises quota
LEAKCHECK_API_KEY=

# Censys              — two-token (CENSYS_API_ID + CENSYS_API_SECRET)
CENSYS_API_ID=
CENSYS_API_SECRET=

# IntelX              — no key needed (public endpoint)
# (no key)

# ---- Auto-discover extra providers (optional) ----
# The built-in registry already includes: VirusTotal, AbuseIPDB, IPAPI,
# crt.sh, LeakCheck, HIBP, Gravatar, SecurityTrails, Username, DNS, WHOIS,
# Shodan, Censys, IntelX. To add your own:
#   1. Drop `app/services/providers/<name>.py` with a BaseProvider subclass
#   2. List it here
# Example: OSINT_EXTRA_PROVIDERS=mynewprovider
OSINT_EXTRA_PROVIDERS=

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60
