# ---- App ----
APP_NAME=OSINT Nexus
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Security ----
# 32+ char random string for JWT signing (local stub auth)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Database ----
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./osint_nexus.db
# Production (Supabase Postgres):
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/DBNAME
DIRECT_URL=postgresql+psycopg2://USER:PASS@HOST:5432/DBNAME

# ---- Supabase (optional, set USE_SUPABASE=true to enable) ----
USE_SUPABASE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- OSINT providers (all optional, all use only public free endpoints) ----
# Have I Been Pwned (https://haveibeenpwned.com/API/v3) — paid, optional
HIBP_API_KEY=
# ipapi.co free tier (no key required, ~1k req/day)
IPAPI_BASE_URL=https://ipapi.co
# AbuseIPDB (free tier available, key optional)
ABUSEIPDB_API_KEY=
# VirusTotal public API (free tier, key optional)
VIRUSTOTAL_API_KEY=

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60
